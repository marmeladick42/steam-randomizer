# Настройки веб-версии (npm run serve / npm run share).
# Скопируйте этот файл в server.env и впишите свой ключ. server.env не попадает в git
# и не отдаётся посетителям сайта.
STEAM_API_KEY=

# Порт и адрес сервера. 127.0.0.1 — сайт доступен только с этого компьютера и через туннель.
PORT=3000
HOST=127.0.0.1

# Регион и язык по умолчанию для новых посетителей (каждый может сменить их у себя в настройках).
STEAM_REGION=us
STEAM_LANGUAGE=russian
