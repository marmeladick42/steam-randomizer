{
  "name": "steam-randomizer",
  "productName": "Steam Randomizer",
  "version": "1.0.0",
  "description": "Случайная игра из Steam по подробным фильтрам",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "check": "node scripts/smoke-test.js",
    "dist": "electron-builder --win portable && node scripts/clean-dist.js",
    "dist:installer": "electron-builder --win nsis && node scripts/clean-dist.js"
  },
  "build": {
    "appId": "local.steam-randomizer",
    "productName": "Steam Randomizer",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
